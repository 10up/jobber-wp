{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jobber/forms",
	"version": "0.1.0",
	"title": "Jobber",
	"category": "widgets",
	"description": "Display a form from your Jobber account.",
	"keywords": [
		"jobber",
		"form",
		"booking",
		"request"
	],
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"formId": {
			"type": "string",
			"default": ""
		},
		"formName": {
			"type": "string",
			"default": ""
		},
		"bookingType": {
			"type": "string",
			"default": ""
		},
		"formType": {
			"type": "string",
			"default": "request"
		}
	},
	"textdomain": "jobber",
	"editorScript": "file:../../dist/blocks/jobber-forms.js"
}
